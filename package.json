{
  "name": "veyra",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "video:studio": "remotion studio video/index.ts",
    "video:render": "node scripts/sync-video-css.mjs && remotion render video/index.ts Veyra launch/veyra-film.mp4 --codec=h264 --crf=17 --concurrency=2",
    "audio:analyze": "python3 scripts/analyze_audio.py",
    "agent:rip": "tsx agent/rip.ts",
    "plugin:build": "cd plugin && pnpm build && cp dist/plugin.mjs ../dist/plugin.mjs",
    "plugin:test": "cd plugin && pnpm test",
    "video:sync": "node scripts/sync-video-css.mjs"
  },
  "dependencies": {
    "@paybox-sh/sdk": "2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@remotion/cli": "4.0.536",
    "@remotion/media": "4.0.536",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "14.3.0",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.536",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
